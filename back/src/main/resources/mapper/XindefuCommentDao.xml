	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.XindefuCommentEntity" id="xindefuCommentMap">
        <result property="id" column="id"/>
        <result property="xindefuId" column="xindefu_id"/>
        <result property="huiyuanzhanghao" column="huiyuanzhanghao"/>
        <result property="huiyuanxingming" column="huiyuanxingming"/>
        <result property="pinglunneirong" column="pinglunneirong"/>
        <result property="pinglunshijian" column="pinglunshijian"/>
