    <select id="selectListView" resultType="com.entity.XindefuCommentEntity">
		SELECT xindefu_comment.* FROM xindefu_comment
        <where>1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView" resultType="com.entity.XindefuCommentEntity">
		SELECT xindefu_comment.* FROM xindefu_comment
        <where>1=1 ${ew.sqlSegment}</where>
	</select>

	<select id="selectView" resultType="com.entity.view.XindefuCommentView">
		SELECT * FROM xindefu_comment xindefu_comment <where>1=1 ${ew.sqlSegment}</where>
	</select>

