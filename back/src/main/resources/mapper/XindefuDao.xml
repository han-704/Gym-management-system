<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.XindefuDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.XindefuEntity" id="xindefuMap">
        <result property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="fenlei" column="fenlei"/>
        <result property="fengmian" column="fengmian"/>
        <result property="fabuzhanghao" column="fabuzhanghao"/>
        <result property="fabuxingming" column="fabuxingming"/>
        <result property="fabushijian" column="fabushijian"/>
        <result property="thumbsupnum" column="thumbsupnum"/>
        <result property="clicknum" column="clicknum"/>
        <result property="addtime" column="addtime"/>
    </resultMap>

    <select id="selectListView" resultType="com.entity.XindefuEntity">
		SELECT xindefu.* FROM xindefu
        <where>1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView" resultType="com.entity.XindefuEntity">
		SELECT xindefu.* FROM xindefu
        <where>1=1 ${ew.sqlSegment}</where>
	</select>

	<select id="selectView" resultType="com.entity.view.XindefuView">
		SELECT * FROM xindefu xindefu <where>1=1 ${ew.sqlSegment}</where>
	</select>

</mapper>
